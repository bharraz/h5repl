# Ignore Python cache and build artifacts
__pycache__/
*.py[cod]
*.so
*.pyd
*.pyo

# Ignore setuptools/distribution metadata
*.egg-info/

# Ignore HDF5 files (except demo data bundled with the repo)
*.h5
*.hdf5
*.he5
!data/000103550-RamanScan.h5
!data/000103551-RamseySeqScan.h5

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore virtual environments
.venv/
venv/
ENV/

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore test and coverage outputs
htmlcov/
.coverage
.tox/

# Ignore user/editor files
*.swp
*.swo
*.bak
*.tmp
.idea/
.vscode/
